/* VITAL REAL — Cursor-AI inspired dark theme for the real-economy agent */

Screen {
    background: #0d1117;
}

#topbar {
    dock: top;
    height: 3;
    background: #161b22;
    border-bottom: thick #21262d;
    padding: 0 1;
}

#topbar .title { color: #e6edf3; text-style: bold; }
#topbar .accent { color: #3fb950; text-style: bold; }
#topbar .subtitle { color: #8b949e; }

#body { layout: horizontal; }

#sidebar {
    width: 34;
    background: #161b22;
    border-right: thick #21262d;
    padding: 1;
}

#main { width: 1fr; padding: 1; }

.card {
    background: #0d1117;
    border: round #30363d;
    padding: 0 1;
    margin-bottom: 1;
}

.card .card-title { color: #8b949e; text-style: bold; width: 100%; }
.big-number { color: #e6edf3; text-style: bold; width: 100%; }
.subtle { color: #8b949e; width: 100%; }
.good { color: #3fb950; }
.warn { color: #d29922; }
.bad  { color: #f85149; }
.info { color: #58a6ff; }
.green { color: #3fb950; }

#activity-log {
    background: #0d1117;
    border: round #30363d;
    height: 1fr;
}

#statusbar {
    dock: bottom;
    height: 1;
    background: #161b22;
    border-top: thick #21262d;
    color: #8b949e;
    padding: 0 1;
}

#overlay {
    align: center middle;
    background: rgba(5, 8, 12, 0.72);
    layer: overlay;
    display: none;
}

#overlay.show { display: block; }

#overlay-box {
    width: 64;
    height: auto;
    background: #161b22;
    border: double #f85149;
    padding: 1 2;
}

#overlay-box .headline { text-style: bold; width: 100%; text-align: center; }
#overlay-body { width: 100%; text-align: center; color: #e6edf3; margin: 1 0; }
#overlay-hint { width: 100%; text-align: center; }
